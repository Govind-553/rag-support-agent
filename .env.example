# Aster & Row AI Support Agent — Environment Variables
# Copy this file to .env and fill in the values (no real credentials needed for this project)

# Optional: Override the embedding model (default: BAAI/bge-small-en-v1.5)
# EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Optional: Override the LLM model (default: Qwen/Qwen2.5-3B-Instruct)
# LLM_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct

# Optional: Override snapshot timestamp used for time-window calculations
# SNAPSHOT_AT=2026-08-15T12:00:00Z
